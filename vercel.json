{
  "version": 2,
  "framework": null,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "^/(\\.env.*|\\.git.*|\\.htaccess|composer\\.(json|lock)|package(-lock)?\\.json|tailwind\\.config\\.js|Dockerfile|\\.nvmrc|\\.gitattributes|\\.gitignore|README\\.md|REPORT\\.md|DEPLOYMENT\\.md|bootstrap\\.php|router\\.php)$",
      "status": 404,
      "dest": "/index.php"
    },
    {
      "src": "^/(vendor|src|scripts|partials|node_modules|storage|logs)(/.*)?$",
      "status": 404,
      "dest": "/index.php"
    },
    {
      "src": "^/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "^/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "^/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "^/(.*)\\.php$",
      "dest": "/$1.php"
    },
    {
      "src": "^/$",
      "dest": "/index.php"
    },
    {
      "src": "^/(.*)",
      "dest": "/$1.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false"
  }
}

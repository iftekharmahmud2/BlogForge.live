# Disable directory browsing & hide server signature
Options -Indexes
ServerSignature Off

# Prevent PHP version disclosure
<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>

# Block direct web access to sensitive application directories
RedirectMatch 403 ^/(vendor|src|scripts|partials|config|node_modules|storage|logs)(/|$)

# Deny direct access to sensitive configuration, secrets, documentation and backup files
<FilesMatch "(?i)^(\.env.*|\.git.*|\.htaccess|.*\.md|.*\.json|.*\.lock|.*\.config\.js|Dockerfile|\.nvmrc|\.gitattributes|\.gitignore|bootstrap\.php|router\.php|.*\.bak|.*\.backup|.*\.orig|.*\.save|.*\.log|.*\.sql|.*\.sh|.*\.bat)$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [QSA,L]
